{
  "tools": [
    {
      "name": "search_products",
      "description": "Search the allover.art catalog (one card per design). Args: query? (free text, e.g. 'cat', 'neon koi'), theme? (canonical theme like Cats/Anime/Skulls, comma-separated for several), section? (mens|womens|kids), color? (main print color), style? (tee|oversized|long_sleeve|oversized_long_sleeve — use the shopper's saved fit from get_user_prefs), limit? (<=48), max_price? (USD). Returns product cards with good_id, price and url.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text search, e.g. 'cat' or 'neon koi'."
          },
          "theme": {
            "type": "string",
            "description": "Canonical theme filter (Cats, Anime, Skulls, ...); comma-separate several."
          },
          "section": {
            "type": "string",
            "description": "Catalog section: mens, womens or kids."
          },
          "color": {
            "type": "string",
            "enum": [
              "Black",
              "Grey",
              "White",
              "Navy",
              "Beige",
              "Turquoise",
              "Pink",
              "Brown",
              "Red",
              "Purple",
              "Olive",
              "Blue",
              "Green",
              "Yellow",
              "Orange",
              "Burgundy",
              "Multicolor"
            ],
            "description": "Main color of the print."
          },
          "style": {
            "type": "string",
            "enum": [
              "tee",
              "oversized",
              "long_sleeve",
              "oversized_long_sleeve"
            ],
            "description": "Garment cut: tee, oversized, long_sleeve or oversized_long_sleeve."
          },
          "limit": {
            "type": "integer",
            "description": "Max cards to return (default 24, max 48)."
          },
          "max_price": {
            "type": "number",
            "description": "Only items priced at or below this amount, USD."
          }
        }
      },
      "title": "Search catalog",
      "annotations": {
        "title": "Search catalog",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total catalog matches for the filters."
          },
          "showing": {
            "type": "integer",
            "description": "Number of cards returned."
          },
          "items": {
            "type": "array",
            "description": "Product cards.",
            "items": {
              "type": "object",
              "properties": {
                "good_id": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                },
                "theme": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "Canonical product page."
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "get_product",
      "description": "Full details of one product by its code: available sizes, fabrics, per-variant price, and the design 'about' text. Args: code (from search_products).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Product code from search_products results."
          }
        },
        "required": [
          "code"
        ]
      },
      "title": "Get product details",
      "annotations": {
        "title": "Get product details",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "good_id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fabrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "description": "Price per size+fabric combination.",
            "items": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string"
                },
                "fabric": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "about": {
            "type": "string",
            "description": "Design description text (may be null)."
          },
          "error": {
            "type": "string",
            "description": "Present when the product was not found."
          }
        }
      }
    },
    {
      "name": "list_collections",
