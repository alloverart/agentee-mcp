              "type": "object",
              "properties": {
                "good_id": {
                  "type": "integer"
                },
                "code": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "fabric": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
